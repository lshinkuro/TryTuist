# =====================================================================
#  TryTuist — .gitignore
#  Prinsip: commit SUMBER (Project.swift, Sources, Resources, Configs),
#  jangan commit HASIL GENERATE (xcodeproj/xcworkspace dari Tuist) & build.
# =====================================================================

### Tuist: project & workspace di-generate ulang dengan `make gen` ###
*.xcodeproj
*.xcworkspace
Derived/
graph.dot
graph.png

### Tuist: dependency & cache ###
Tuist/.build/
Tuist/.swiftpm/
.tuist-version.lock
.tuist-bin/

### Xcode: data per user & hasil build ###
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
*.xcresult
timeline.xctimeline
playground.xcworkspace

### Swift Package Manager ###
.build/
.swiftpm/
Packages/
Package.resolved

### CocoaPods (bila nanti dipakai) ###
Pods/

### Fastlane ###
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
fastlane/README.md

### Rahasia & sertifikat — JANGAN di-commit ###
# Simpan versi lokal yang berisi kunci asli di file *.local.xcconfig,
# lalu include dari Configs/<Env>.xcconfig:  #include? "Dev.local.xcconfig"
Configs/*.local.xcconfig
.env
.env.*
!.env.example
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
GoogleService-Info.plist

### macOS ###
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### Editor & tools ###
.vscode/
.idea/
*.swp
*~
.claude/settings.local.json

### Log & sementara ###
*.log
*.tmp
