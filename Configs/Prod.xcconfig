//
//  Prod.xcconfig
//  Production: App Store. Build Release.
//
#include "Shared.xcconfig"

APP_ENV = prod
APP_DISPLAY_NAME = TryTuist
BUNDLE_ID_SUFFIX =

// TODO: ganti dengan domain production asli.
API_BASE_URL = https:/$()/api.trytuist.com
API_KEY = prod-api-key-change-me

USE_MOCK_DATA = NO

// Google Sign-In: OAuth client ID tipe iOS untuk bundle ID com.lshinkuro.TryTuist
// (Google Cloud Console → Credentials). Kosong = tombol Google menampilkan pesan "belum dikonfigurasi".
// REVERSED = urutan dibalik, mis. 1234-abc.apps.googleusercontent.com → com.googleusercontent.apps.1234-abc
GOOGLE_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.not-configured
